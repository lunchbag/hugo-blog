@charset "UTF-8";
body {
  background-color: #f9f9f9;
  width: 100%;
  height: 100%;
  margin: 0; }

/* Index page with list of posts */
.index-container {
  margin: 50px auto;
  width: 60%;
  max-width: 860px;
  padding: 0; }
  @media (max-width: 900px) {
    .index-container {
      width: 85%; } }
  @media (max-width: 600px) {
    .index-container {
      width: 100%;
      margin: 50px auto;
      padding: 0 40px;
      box-sizing: border-box; } }
  @media (max-width: 500px) {
    .index-container {
      padding: 0 20px; } }
  .index-container h2 {
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    margin: 0 0 12px;
    font-size: 1.1rem; }
  .index-container .posts h2 {
    margin-top: 48px;
    width: 100px;
    padding-right: 20px;
    text-align: right;
    box-sizing: content-box; }
  .index-container .hero {
    margin-bottom: 0; }
  .index-container .hero-row {
    display: flex;
    align-items: flex-start;
    gap: 32px;
    overflow: visible; }
  .index-container .hero-avatar,
  .index-container #profile-image {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    margin: 0; }
  .index-container .hero-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible; }
  .index-container .hero-title {
    margin: 0 0 4px; }
  .index-container .hero-location {
    font-family: "Merriweather", serif;
    font-size: 0.85rem;
    font-weight: 300;
    color: #888;
    margin: 0 0 16px;
    line-height: 1.5; }
  .index-container .introduction {
    max-width: 700px;
    font-family: "Merriweather", serif;
    line-height: 1.8rem;
    font-weight: 300;
    margin-bottom: 20px; }
    .index-container .introduction span {
      display: block;
      font-size: 0.9rem;
      margin: 0 0 12px; }
      .index-container .introduction span:last-child {
        margin-bottom: 0; }
  .index-container .social-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 0 20px;
    padding: 2px 0 6px;
    overflow: visible; }
  .index-container .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: none !important;
    background: #fff;
    color: #333 !important;
    box-shadow: 0 0 0 1px #ddd;
    text-decoration: none !important;
    transition: box-shadow 0.15s ease, background 0.15s ease; }
    .index-container .social-link:hover {
      box-shadow: 0 0 0 1px #f42c56;
      background: #fff5f7;
      border-bottom: none !important; }
    .index-container .social-link svg {
      display: block;
      width: 18px;
      height: 18px;
      fill: currentColor;
      flex-shrink: 0; }
  .index-container .subscribe-options {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin: 0; }
  .index-container a#subscribe-button,
  .index-container a#rss-button {
    border-radius: 3px;
    font-family: "Montserrat", sans-serif;
    font-size: 1.05rem;
    padding: 0.5em 1em !important;
    font-weight: 600;
    text-decoration: none !important;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease; }
    .index-container a#subscribe-button:hover, .index-container a#subscribe-button:focus-visible,
    .index-container a#rss-button:hover,
    .index-container a#rss-button:focus-visible {
      text-decoration: none !important;
      border-bottom: none !important;
      transform: none;
      outline: none; }
  .index-container a#subscribe-button {
    border: 1px solid #f42c56 !important;
    background-color: #f42c56;
    color: #fff !important; }
    .index-container a#subscribe-button:hover, .index-container a#subscribe-button:focus-visible {
      border: 1px solid #e0254d !important;
      background-color: #e0254d;
      color: #fff !important; }
  .index-container a#rss-button {
    border: none !important;
    background-color: #fff;
    color: #f42c56 !important;
    box-shadow: inset 0 0 0 3px #f42c56; }
    .index-container a#rss-button:hover, .index-container a#rss-button:focus-visible {
      border: none !important;
      background-color: #fff5f7;
      color: #f42c56 !important;
      box-shadow: inset 0 0 0 3px #f42c56; }
  @media (max-width: 500px) {
    .index-container .hero-row {
      flex-direction: column;
      align-items: center;
      gap: 24px; }
    .index-container .hero-copy {
      align-self: stretch;
      width: 100%; }
    .index-container .hero-location {
      margin-bottom: 12px; }
    .index-container .introduction {
      margin-bottom: 16px; }
    .index-container .social-row {
      justify-content: center;
      margin-bottom: 16px; }
    .index-container .subscribe-options {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      gap: 10px; }
    .index-container a#subscribe-button,
    .index-container a#rss-button {
      display: block;
      box-sizing: border-box;
      width: 100%;
      text-align: center; }
    .index-container .posts h2 {
      width: auto;
      padding-right: 0;
      text-align: left; } }
  .index-container .post-list {
    display: flex;
    flex-direction: column; }
    .index-container .post-list .post {
      display: flex;
      margin-top: 8px; }
      @media (max-width: 500px) {
        .index-container .post-list .post {
          flex-direction: column; } }
      .index-container .post-list .post .post-date {
        min-width: 100px;
        padding-right: 20px;
        position: relative;
        top: -3px;
        text-align: right;
        font-family: "Merriweather";
        font-size: 0.8rem;
        font-weight: 300;
        line-height: 1.8rem;
        color: #beb8ba;
        white-space: nowrap; }
        @media (max-width: 500px) {
          .index-container .post-list .post .post-date {
            text-align: left; } }
      .index-container .post-list .post .post-title {
        font-family: "Montserrat";
        font-weight: 700;
        font-size: 1.1rem; }
        @media (max-width: 500px) {
          .index-container .post-list .post .post-title {
            margin-bottom: 20px; } }
  .index-container a:not(.social-link):not(#subscribe-button):not(#rss-button) {
    text-decoration: none;
    color: #222;
    border-bottom: 1px dashed #aaa; }
    .index-container a:not(.social-link):not(#subscribe-button):not(#rss-button):hover {
      border-bottom: none; }

/* Individual post page */
#g-post {
  width: 700px;
  margin: 150px auto;
  font-weight: normal;
  color: #333;
  display: block;
  /* Date/Author */
  /* Content */
  /* Links */ }
  @media (max-width: 800px) {
    #g-post {
      width: 100%;
      padding: 0 50px;
      box-sizing: border-box; } }
  @media (max-width: 600px) {
    #g-post {
      margin: 0 auto 280px auto;
      width: 100%;
      padding: 0 20px;
      box-sizing: border-box; } }
  @media (max-width: 1000px) {
    #g-post .collapse-on-mobile {
      flex-direction: column;
      padding-bottom: 80px; }
      #g-post .collapse-on-mobile img {
        width: 100% !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        margin-top: 0 !important;
        margin-bottom: -40px !important; } }
  #g-post h1.title {
    font-family: "Source Sans Pro" !important;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 3rem;
    text-align: center;
    color: #f42c56;
    margin-bottom: 0px; }
    @media (max-width: 800px) {
      #g-post h1.title {
        font-size: 2.5rem; } }
    @media (max-width: 600px) {
      #g-post h1.title {
        font-size: 2rem; } }
  #g-post h1,
  #g-post h2,
  #g-post h3,
  #g-post h4 {
    font-family: "Roboto Slab";
    font-weight: 700;
    margin-top: 45px; }
  #g-post h1 {
    text-align: center; }
    @media (max-width: 1100px) {
      #g-post h1 {
        font-size: 2rem; } }
    @media (max-width: 800px) {
      #g-post h1 {
        font-size: 1.8rem; } }
    @media (max-width: 600px) {
      #g-post h1 {
        font-size: 1.7rem; } }
    @media (max-width: 500px) {
      #g-post h1 {
        font-size: 1.5rem; } }
  #g-post h2 {
    text-align: center;
    font-size: 1.6rem; }
    @media (max-width: 600px) {
      #g-post h2 {
        font-size: 1.5rem; } }
    @media (max-width: 500px) {
      #g-post h2 {
        font-size: 1.3rem; } }
  #g-post h3 {
    font-size: 1.35rem; }
    @media (max-width: 600px) {
      #g-post h3 {
        font-size: 1.2rem; } }
    @media (max-width: 500px) {
      #g-post h3 {
        font-size: 1.1rem; } }
  #g-post h4 {
    font-size: 1.2rem; }
    @media (max-width: 600px) {
      #g-post h4 {
        font-size: 1.1rem; } }
    @media (max-width: 500px) {
      #g-post h4 {
        font-size: 1.1rem; } }
  #g-post b,
  #g-post strong {
    font-weight: 900; }
  #g-post .post-info {
    text-align: center;
    margin-top: 18px;
    margin-bottom: 64px; }
    #g-post .post-info span {
      font-family: "Source Sans Pro";
      font-weight: 700;
      text-transform: uppercase;
      background-color: #ccc;
      color: #fff;
      padding: 2px 10px;
      box-shadow: 2px 2px 0px 0px #aaa; }
  #g-post p,
  #g-post ul,
  #g-post ol {
    font-family: "Avenir";
    font-weight: 200;
    font-size: 1.2rem;
    line-height: 2rem;
    margin: 20px auto;
    position: relative; }
    @media (max-width: 600px) {
      #g-post p,
      #g-post ul,
      #g-post ol {
        font-size: 1rem;
        font-weight: 400;
        line-height: 2rem; } }
  #g-post span.highlight {
    padding: 2px 2px;
    background-color: #fff71c; }
  #g-post p.tip {
    position: relative;
    background-color: #ed3b61;
    color: #fff;
    padding: 10px 20px; }
  #g-post p.tip:before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    border-width: 0 20px 20px 0;
    border-style: solid;
    border-color: #ce2347 #f6f6f6; }
  #g-post p.note {
    display: block;
    border: 1px solid black;
    padding: 20px 32px; }
  #g-post code {
    font-size: 1rem;
    font-family: "Inconsolata";
    font-weight: 400;
    color: #333;
    background-color: #f0f0f0;
    padding: 2px 4px;
    border-radius: 4px;
    border: 1px solid #ccc; }
  #g-post img {
    display: block;
    margin: 32px auto;
    position: relative;
    width: 100%;
    z-index: -1;
    border: 1px solid #eee; }
    #g-post img.expanded {
      width: 140% !important;
      left: -20%; }
      @media (max-width: 980px) {
        #g-post img.expanded {
          width: 100% !important;
          left: 0; } }
    #g-post img + span.credit {
      font-family: "Inconsolata";
      font-size: 1rem;
      font-weight: 900;
      padding: 0 20px;
      background-color: #21e0ff;
      position: absolute;
      top: 52px;
      right: -10px; }
      #g-post img + span.credit > a {
        border-bottom: none;
        color: #fff; }
      #g-post img + span.credit > a:hover {
        background-color: transparent;
        color: #000; }
      #g-post img + span.credit:before {
        content: "";
        position: absolute;
        border-style: solid;
        bottom: 100%;
        right: 0;
        border-width: 0.7em 0 0 0.7em;
        border-color: transparent #08a3bd transparent #08a3bd; }
    #g-post img.expanded + span.credit {
      right: calc(-20% - 12px); }
      @media (max-width: 980px) {
        #g-post img.expanded + span.credit {
          right: -12px; } }
    #g-post img:not(.expanded) + span.credit {
      right: -12px; }
    #g-post img + span.caption, #g-post img + span.credit + span.caption {
      font-family: "Inconsolata";
      font-size: 1.1rem;
      font-weight: bold;
      text-align: center;
      display: block;
      width: 85%;
      background-color: #fff71c;
      padding: 10px;
      margin: -50px auto 0 auto;
      z-index: 10;
      color: #3e3a3a;
      line-height: 1.4rem; }
      @media (max-width: 600px) {
        #g-post img + span.caption, #g-post img + span.credit + span.caption {
          font-size: 0.9rem;
          line-height: 1.2rem;
          padding-top: 5px;
          padding-bottom: 5px; } }
    #g-post img .inline {
      width: 60% !important;
      left: -5% !important;
      margin-top: 10px;
      float: left; }
    #g-post img .inline + p {
      display: inline; }
  #g-post span.caption {
    font-family: "Inconsolata";
    font-size: 1.1rem;
    font-weight: bold;
    text-align: center;
    display: block;
    width: 85%;
    background-color: #fff71c;
    padding: 10px;
    margin: -50px auto 0 auto;
    z-index: 10;
    color: #3e3a3a;
    line-height: 1.4rem; }
    @media (max-width: 600px) {
      #g-post span.caption {
        font-size: 0.9rem;
        line-height: 1.2rem;
        padding-top: 5px;
        padding-bottom: 5px; } }
  #g-post small {
    display: block;
    border-top: 1px solid #ddd;
    padding-top: 16px;
    margin-top: 64px; }
  #g-post a {
    padding: 0;
    position: relative;
    color: #333;
    font-weight: 600;
    text-decoration: none;
    z-index: 1;
    border-bottom: 4px solid #21e0ff; }
  #g-post a:hover {
    color: #000;
    border-bottom: 0; }
  #g-post p.tip a {
    color: #fff;
    border-bottom: 2px solid #fff; }
  #g-post blockquote {
    margin: 40px 0;
    padding: 20px 40px;
    background-color: #fff;
    border-left: 10px solid #00fa9a;
    font-family: "Amiri", "Merriweather", sans-serif; }
  #g-post input {
    font-size: 1em;
    padding: 10px;
    width: 50px;
    text-align: center; }
  #g-post table {
    margin-bottom: 40px;
    font-family: sans-serif;
    line-height: 2.0225; }
  #g-post td {
    padding: 2px 10px; }
  #g-post .post-post .thank-you {
    margin: 48px auto 0 auto;
    text-align: center; }
    #g-post .post-post .thank-you span {
      font-family: "Source Sans Pro";
      font-weight: 700;
      text-transform: uppercase;
      background-color: #e0e0e0;
      color: #fff;
      padding: 2px 10px;
      box-shadow: 1px 1px 0px 0px #ccc; }
  #g-post .post-post .author {
    margin: 4em 0 1em 0;
    padding: 1.5em 1.5em;
    border-radius: 10px;
    background-color: #fff1d9;
    display: flex;
    align-items: center; }
    #g-post .post-post .author .image-container {
      min-width: 100px;
      max-width: 100px; }
      #g-post .post-post .author .image-container img {
        z-index: 1;
        margin: 0;
        width: 100%;
        border: 0; }
    @media (max-width: 600px) {
      #g-post .post-post .author {
        flex-direction: column;
        justify-content: center; }
        #g-post .post-post .author .image-container {
          padding-top: 8px;
          padding-bottom: 12px; }
        #g-post .post-post .author .author-name {
          padding-left: 0 !important; } }
    #g-post .post-post .author .author-name {
      padding-left: 1.25em;
      margin: 0;
      font-weight: 300;
      font-size: 1.1rem;
      line-height: 1.8rem; }
  #g-post .post-post .feedback {
    margin: 64px auto 0 auto;
    text-align: center; }
    #g-post .post-post .feedback button {
      font-family: "Source Sans Pro";
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      background: transparent;
      color: #000;
      border: 2px solid #000;
      padding: 20px 50px;
      position: relative;
      top: 0;
      transition: all 0.1s ease-in; }
      #g-post .post-post .feedback button:hover {
        background-color: #000;
        color: #fff;
        cursor: pointer;
        top: -3px; }
  #g-post .post-post .next-prev-post {
    display: flex;
    justify-content: space-between; }
    #g-post .post-post .next-prev-post .post-post-container {
      width: 48%; }
      #g-post .post-post .next-prev-post .post-post-container:last-child h1,
      #g-post .post-post .next-prev-post .post-post-container:last-child p {
        text-align: right; }
      #g-post .post-post .next-prev-post .post-post-container a {
        position: relative;
        top: 0;
        transition: all 0.1s ease-in; }
        #g-post .post-post .next-prev-post .post-post-container a:hover {
          top: -3px;
          cursor: pointer; }
    #g-post .post-post .next-prev-post h1 {
      font-size: 1rem;
      font-family: "Source Sans Pro";
      text-transform: uppercase;
      color: #f42c56;
      padding-bottom: 4px;
      border-bottom: 3px solid #f42c56; }
    #g-post .post-post .next-prev-post p {
      text-align: justify;
      margin-top: 0;
      font-size: 1.05rem;
      line-height: 1.6rem; }
    #g-post .post-post .next-prev-post a {
      display: block;
      color: #000;
      font-weight: 300;
      border-bottom: none;
      padding: 0; }
      #g-post .post-post .next-prev-post a:hover {
        background: none; }
  #g-post .post-post div.back-to-home {
    margin: 0 auto;
    width: 100%;
    font-family: "Source Sans Pro", sans-serif;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    font-size: 1em; }

#floating-subscribe {
  background-color: #fff;
  height: fit-content;
  border: 1px solid #ccc;
  padding: 1em 1.15em;
  border-radius: 3px;
  position: fixed;
  right: 1em;
  bottom: -220px;
  width: 260px;
  z-index: 100;
  transition: bottom 0.1s ease-in; }
  #floating-subscribe.visible {
    bottom: 1em; }
  @media (max-width: 400px) {
    #floating-subscribe {
      width: 100%;
      box-sizing: border-box;
      right: 0;
      bottom: -250px;
      border-radius: 0;
      border-right-width: 0;
      border-left-width: 0; }
      #floating-subscribe:hover {
        cursor: pointer; }
      #floating-subscribe.visible {
        bottom: -3px; } }
  #floating-subscribe .clickable:hover {
    cursor: pointer; }
  #floating-subscribe h2 {
    text-align: left !important;
    margin-top: 0px !important;
    font-size: 1.2rem !important;
    cursor: pointer; }
  #floating-subscribe p {
    font-size: 1rem !important;
    line-height: 1.4rem !important;
    margin: 0.5em 0 1em 0 !important; }
  #floating-subscribe span {
    display: block;
    text-align: center;
    margin-top: 0.5em;
    font-family: "Nunito", sans-serif;
    font-size: 0.7em;
    color: #888; }

/* Tabular tables */
#g-post table {
  width: 100%;
  margin: 30px auto 30px auto;
  font-size: 0.9rem;
  font-family: "Karla";
  border-collapse: collapse; }

#g-post thead {
  border-bottom: 2px solid #63585f; }
  #g-post thead th {
    text-transform: uppercase;
    font-weight: bold;
    text-align: right;
    padding-left: 10px;
    padding-bottom: 10px; }
    #g-post thead th:first-child {
      text-align: left;
      padding-left: 10px; }
    #g-post thead th:last-child {
      padding-right: 10px; }

#g-post tbody tr:hover {
  cursor: default;
  background-color: #fff121; }

#g-post tfoot {
  border-top: 2px solid #63585f;
  border-bottom: 2px solid #63585f;
  font-weight: bold; }

#g-post td {
  padding: 10px 0px 10px 10px; }
  #g-post tdlast-child {
    padding-right: 10px; }
  #g-post td.col1 {
    text-transform: capitalize; }
  #g-post td.datacol {
    text-align: right; }

.g-post-header {
  height: 80px;
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  border-bottom: 1px solid #dfdfdf;
  background-color: #fff;
  z-index: 100;
  transition: top 0.1s linear; }
  .g-post-header .container {
    width: 1050px;
    height: 100%;
    margin: 0 auto;
    font-weight: normal;
    color: #333;
    display: flex;
    justify-content: center;
    align-items: center; }
    @media (max-width: 800px) {
      .g-post-header .container {
        width: 100%;
        padding: 0 50px;
        box-sizing: border-box; } }
    @media (max-width: 600px) {
      .g-post-header .container {
        margin: 0 auto;
        width: 100%;
        padding: 0 20px;
        box-sizing: border-box; } }
  .g-post-header.smaller {
    background: transparent;
    border-bottom: none;
    height: 60px;
    top: 60px; }
    .g-post-header.smaller .container {
      justify-content: flex-start; }
    .g-post-header.smaller li.home {
      font-size: 1.5rem; }
  .g-post-header ul {
    list-style: none;
    margin: 0;
    padding: 0; }
  .g-post-header li.home {
    font-family: "Montserrat";
    font-size: 2rem;
    font-weight: 700;
    transition: all 0.1s linear; }

/* Gated / unlocked pages (content/unlocked) */
#g-post.unlocked .unlocked-badge-wrap {
  text-align: center;
  margin-bottom: 20px; }

#g-post.unlocked .unlocked-badge {
  display: inline-block;
  font-family: "Source Sans Pro", sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  background-color: #333;
  padding: 4px 12px;
  box-shadow: 2px 2px 0 0 #aaa; }

#g-post.unlocked h1.title {
  margin-bottom: 12px; }

#g-post.unlocked .unlocked-subtitle {
  text-align: center;
  font-family: "Merriweather", serif;
  font-weight: 300;
  font-size: 1.05rem;
  line-height: 1.7rem;
  color: #666;
  margin: 0 auto 56px;
  max-width: 560px; }

#g-post.unlocked .unlocked-file {
  margin: 48px 0 16px;
  text-align: center; }

#g-post.unlocked .unlocked-download,
#g-post.unlocked .unlocked-button {
  display: inline-block;
  font-family: "Montserrat", sans-serif;
  font-weight: 600;
  font-size: 1.05rem;
  color: #fff;
  background-color: #f42c56;
  border: 1px solid #f42c56;
  border-bottom: 1px solid #f42c56;
  border-radius: 3px;
  padding: 0.6em 1.2em;
  text-decoration: none;
  transition: background-color 0.15s ease, border-color 0.15s ease; }
  #g-post.unlocked .unlocked-download:hover, #g-post.unlocked .unlocked-download:focus-visible,
  #g-post.unlocked .unlocked-button:hover,
  #g-post.unlocked .unlocked-button:focus-visible {
    color: #fff;
    background-color: #e0254d;
    border-color: #e0254d;
    border-bottom: 1px solid #e0254d; }

#g-post.unlocked .unlocked-embed {
  display: block;
  width: 100%;
  height: 75vh;
  min-height: 480px;
  max-height: 900px;
  margin: 24px 0 8px;
  border: 1px solid #ddd;
  border-radius: 3px;
  background-color: #fff; }
  @media (max-width: 600px) {
    #g-post.unlocked .unlocked-embed {
      height: 60vh;
      min-height: 360px; } }
#g-post.unlocked .unlocked-embed-fallback {
  font-size: 0.95rem;
  color: #888;
  text-align: center;
  margin-top: 4px; }

#g-post.unlocked .post-post {
  /* "More from the blog" -- mirrors the index page post list */ }
  #g-post.unlocked .post-post .unlocked-card {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 3px;
    padding: 28px 32px;
    margin-bottom: 32px; }
    @media (max-width: 600px) {
      #g-post.unlocked .post-post .unlocked-card {
        padding: 20px; } }
    #g-post.unlocked .post-post .unlocked-card h2 {
      text-align: left;
      font-size: 1.4rem;
      margin: 0 0 12px; }
    #g-post.unlocked .post-post .unlocked-card p {
      font-size: 1.05rem;
      line-height: 1.7rem;
      margin: 0 0 14px; }
  #g-post.unlocked .post-post .unlocked-newsletter .unlocked-button {
    margin-top: 6px; }
  #g-post.unlocked .post-post .unlocked-more {
    margin: 64px 0 48px; }
    #g-post.unlocked .post-post .unlocked-more h2 {
      font-family: "Montserrat", sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      text-align: left;
      width: 100%;
      margin: 0 0 12px; }
    #g-post.unlocked .post-post .unlocked-more .post-list {
      display: flex;
      flex-direction: column; }
    #g-post.unlocked .post-post .unlocked-more .post {
      display: flex;
      margin-top: 8px; }
      @media (max-width: 500px) {
        #g-post.unlocked .post-post .unlocked-more .post {
          flex-direction: column; } }
    #g-post.unlocked .post-post .unlocked-more .post-date {
      min-width: 100px;
      padding-right: 20px;
      position: relative;
      top: -3px;
      text-align: right;
      font-family: "Merriweather", serif;
      font-size: 0.8rem;
      font-weight: 300;
      line-height: 1.8rem;
      color: #beb8ba;
      white-space: nowrap; }
      @media (max-width: 500px) {
        #g-post.unlocked .post-post .unlocked-more .post-date {
          text-align: left; } }
    #g-post.unlocked .post-post .unlocked-more .post-title {
      font-family: "Montserrat", sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      line-height: 1.6rem; }
      @media (max-width: 500px) {
        #g-post.unlocked .post-post .unlocked-more .post-title {
          margin-bottom: 14px; } }
      #g-post.unlocked .post-post .unlocked-more .post-title a {
        font-weight: 700;
        color: #222;
        text-decoration: none;
        border-bottom: 1px dashed #aaa; }
        #g-post.unlocked .post-post .unlocked-more .post-title a:hover {
          border-bottom: none; }
    #g-post.unlocked .post-post .unlocked-more .see-all {
      margin-top: 16px; }
      #g-post.unlocked .post-post .unlocked-more .see-all .post-title a {
        font-weight: 600;
        color: #f42c56;
        border-bottom: none; }
  #g-post.unlocked .post-post .unlocked-share-note {
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.5rem;
    color: #888;
    margin: 0 auto 40px;
    max-width: 480px; }

/* Interactive worksheet (pages with interactive = true) */
#g-post.unlocked {
  /* Collapsible freedoms in part two */
  /* Pick your four */
  /* Toolbar */ }
  #g-post.unlocked .ws-note {
    text-align: center;
    font-family: "Nunito", sans-serif;
    font-size: 0.9rem;
    color: #888;
    margin: -32px auto 48px;
    max-width: 520px;
    line-height: 1.5rem; }
    #g-post.unlocked .ws-note #ws-status {
      display: block;
      font-family: "Inconsolata", monospace;
      font-size: 0.85rem;
      color: #aaa;
      margin-top: 4px;
      min-height: 1.2em; }
  #g-post.unlocked .ws-q {
    margin: 22px 0 26px; }
    #g-post.unlocked .ws-q label {
      display: block;
      font-family: "Avenir", "Nunito", sans-serif;
      font-weight: 600;
      font-size: 1.1rem;
      line-height: 1.7rem;
      color: #333;
      margin-bottom: 8px; }
      #g-post.unlocked .ws-q label p {
        margin: 0;
        font-weight: inherit;
        font-size: inherit;
        line-height: inherit; }
  #g-post.unlocked .ws-q textarea,
  #g-post.unlocked .ws-pick textarea,
  #g-post.unlocked .ws-pick input[type="text"] {
    display: block;
    box-sizing: border-box;
    width: 100%;
    font-family: "Avenir", "Nunito", sans-serif;
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.6rem;
    color: #333;
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 3px;
    padding: 12px 14px;
    resize: none;
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease; }
    #g-post.unlocked .ws-q textarea::placeholder,
    #g-post.unlocked .ws-pick textarea::placeholder,
    #g-post.unlocked .ws-pick input[type="text"]::placeholder {
      color: #bbb; }
    #g-post.unlocked .ws-q textarea:focus,
    #g-post.unlocked .ws-pick textarea:focus,
    #g-post.unlocked .ws-pick input[type="text"]:focus {
      outline: none;
      border-color: #f42c56;
      box-shadow: 0 0 0 3px rgba(244, 44, 86, 0.12); }
  #g-post.unlocked .ws-pick input[type="text"] {
    font-weight: 600;
    margin-bottom: 14px; }
  #g-post.unlocked .ws-freedom {
    border-top: 1px solid #ddd;
    margin: 0; }
    #g-post.unlocked .ws-freedom:last-of-type {
      border-bottom: 1px solid #ddd; }
    #g-post.unlocked .ws-freedom summary {
      list-style: none;
      cursor: pointer;
      padding: 20px 36px 20px 0;
      position: relative;
      user-select: none; }
      #g-post.unlocked .ws-freedom summary::-webkit-details-marker {
        display: none; }
      #g-post.unlocked .ws-freedom summary::after {
        content: "+";
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: #f42c56;
        transition: transform 0.15s ease; }
      #g-post.unlocked .ws-freedom summary:hover .ws-freedom-name {
        color: #f42c56; }
    #g-post.unlocked .ws-freedom[open] summary::after {
      content: "–"; }
    #g-post.unlocked .ws-freedom .ws-freedom-name {
      display: block;
      font-family: "Roboto Slab", serif;
      font-weight: 700;
      font-size: 1.3rem;
      line-height: 1.6rem;
      transition: color 0.15s ease; }
    #g-post.unlocked .ws-freedom .ws-freedom-badge {
      display: inline-block;
      vertical-align: middle;
      position: relative;
      top: -2px;
      margin-left: 8px;
      font-family: "Source Sans Pro", sans-serif;
      font-weight: 700;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fff;
      background-color: #f42c56;
      padding: 2px 8px;
      border-radius: 2px; }
    #g-post.unlocked .ws-freedom .ws-freedom-tagline {
      display: block;
      font-family: "Merriweather", serif;
      font-weight: 300;
      font-size: 0.95rem;
      line-height: 1.5rem;
      color: #777;
      margin-top: 4px; }
    #g-post.unlocked .ws-freedom .ws-freedom-body {
      padding: 0 0 24px; }
      #g-post.unlocked .ws-freedom .ws-freedom-body > p:first-child {
        margin-top: 8px; }
      #g-post.unlocked .ws-freedom .ws-freedom-body h4 {
        margin-top: 24px; }
  #g-post.unlocked .ws-pick {
    margin: 32px 0; }
  #g-post.unlocked .ws-pick-slot {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 36px; }
    @media (max-width: 500px) {
      #g-post.unlocked .ws-pick-slot {
        gap: 14px; } }
  #g-post.unlocked .ws-pick-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #f42c56;
    color: #fff;
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px; }
  #g-post.unlocked .ws-pick-fields {
    flex: 1;
    min-width: 0; }
    #g-post.unlocked .ws-pick-fields label {
      display: block;
      font-family: "Avenir", "Nunito", sans-serif;
      font-weight: 600;
      font-size: 1rem;
      color: #555;
      margin-bottom: 6px; }
  #g-post.unlocked .ws-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 56px 0 24px; }
    #g-post.unlocked .ws-tools button {
      font-family: "Montserrat", sans-serif;
      font-weight: 600;
      font-size: 0.95rem;
      padding: 0.6em 1.1em;
      border-radius: 3px;
      cursor: pointer;
      border: 1px solid #f42c56;
      background-color: #f42c56;
      color: #fff;
      transition: background-color 0.15s ease, color 0.15s ease; }
      #g-post.unlocked .ws-tools button:hover {
        background-color: #e0254d; }
      #g-post.unlocked .ws-tools button.secondary {
        background-color: #fff;
        color: #f42c56; }
        #g-post.unlocked .ws-tools button.secondary:hover {
          background-color: #fff5f7; }
      #g-post.unlocked .ws-tools button.quiet {
        background-color: transparent;
        border-color: transparent;
        color: #999; }
        #g-post.unlocked .ws-tools button.quiet:hover {
          color: #333;
          background-color: transparent; }

.print-only {
  display: none; }

@media print {
  @page {
    margin: 18mm 16mm 22mm; }
  #g-post.unlocked {
    margin: 0 auto;
    width: 100%;
    padding-bottom: 24px; }
    #g-post.unlocked .unlocked-badge-wrap, #g-post.unlocked .ws-note, #g-post.unlocked .ws-tools, #g-post.unlocked .post-post {
      display: none !important; }
    #g-post.unlocked .print-byline {
      display: block;
      text-align: center;
      font-family: "Merriweather", serif;
      font-weight: 300;
      font-size: 0.9rem;
      color: #666;
      margin: -40px 0 40px; }
    #g-post.unlocked .print-closing {
      display: block;
      text-align: center;
      font-family: "Merriweather", serif;
      font-weight: 300;
      font-size: 0.95rem;
      color: #666;
      border-top: 1px solid #ddd;
      padding-top: 20px;
      margin-top: 48px; }
    #g-post.unlocked .print-footer {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      text-align: center;
      font-family: "Inconsolata", monospace;
      font-size: 9pt;
      color: #888;
      background: #fff;
      padding: 4px 0 0; }
    #g-post.unlocked .ws-freedom summary::after {
      display: none; }
    #g-post.unlocked .ws-q textarea, #g-post.unlocked .ws-pick textarea, #g-post.unlocked .ws-pick input[type="text"] {
      border: 1px solid #999;
      box-shadow: none; }
    #g-post.unlocked .ws-freedom, #g-post.unlocked .ws-pick-slot, #g-post.unlocked .ws-q {
      break-inside: avoid; } }

